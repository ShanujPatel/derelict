# Copy to .env.local to try the online leaderboard while developing.
# Both values come from Supabase: Project Settings -> API (see docs/LEADERBOARD.md).
# The publishable key is safe to expose in the browser; never put a secret/service key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
